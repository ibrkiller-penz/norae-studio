{
  "name": "norae-studio",
  "productName": "노래공방",
  "version": "1.2.4",
  "description": "로컬 GPU로 노래를 만드는 AI 작곡 프로그램 (YuE2 기반)",
  "main": "electron/main.js",
  "author": "happy",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "test": "node electron/speed.test.js && node electron/models.test.js && node renderer/lyrics.test.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.local.noraestudio",
    "productName": "노래공방",
    "files": [
      "electron/**",
      "renderer/**",
      "python/**",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "python/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NoraeStudio-Setup-${version}.${ext}"
    }
  }
}
